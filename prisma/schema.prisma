generator client {
  provider      = "prisma-client-js"
  // Vercel serverless runs on Linux (rhel); native is for local dev.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model ContactSubmission {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  name      String
  email     String
  topic     String   @default("Other")
  message   String
}

/// Editable marketing / legal copy (see `/admin/site-copy`).
model SiteCopyBlock {
  id        String   @id @default(cuid())
  key       String   @unique
  label     String
  /// plain | html | mdx
  format    String   @default("plain")
  value     String   @default("")
  updatedAt DateTime @updatedAt
}

model Product {
  id           String   @id @default(cuid())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  name         String
  slug         String   @unique
  description  String?
  priceCents   Int
  /// JSON array of HTTPS image URLs (stored as text); first is used for cards / checkout.
  imageUrls    String   @default("[]")
  /// JSON array of size labels (stored as text), e.g. ["XS","S","M","L","XL"].
  sizesJson    String   @default("[]")
  /// Shopper-facing label for sizesJson, e.g. "Size" or "Colour". Empty uses "Option".
  optionsLabel String   @default("")
  published    Boolean  @default(false)
  /// birds | flamingos | cats | abstract | other — shop filters
  categorySlug String   @default("other")
  /// JSON array of display tags, e.g. [{"label":"Sweater","color":"mint"}].
  tagsJson     String   @default("[]")

  @@index([published, categorySlug])
  @@index([published, priceCents])
}

/// Paid checkout sessions (created from Stripe webhook).
model Order {
  id                    String   @id @default(cuid())
  createdAt             DateTime @default(now())
  stripeSessionId       String   @unique
  stripePaymentIntentId String?
  productId             String?
  productName           String
  productSlug           String?
  size                  String?
  itemCount             Int      @default(1)
  /// JSON array of line items for multi-product cart checkouts.
  lineItemsJson         String?
  amountCents           Int
  currency              String   @default("cad")
  customerEmail         String?
  customerName          String?
  /// JSON shipping address from Stripe (if collected).
  shippingJson          String?
  status                String   @default("paid")

  @@index([createdAt])
}
