# PostgreSQL (required). Use Neon, Supabase, Vercel Postgres, Railway, or local Postgres.
# Example (Neon): postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Admin JWT — use a long random string (32+ chars) in production
AUTH_SECRET="replace-with-a-long-random-secret-at-least-32-chars"

# Admin login for /admin (optional username — if set, username + password must match)
# Avoid wrapping in quotes unless your host requires it; special chars like ! are fine unquoted.
ADMIN_USERNAME=
ADMIN_PASSWORD=change-me

# Stripe — https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Webhook signing secret — https://dashboard.stripe.com/webhooks
# Endpoint URL: https://YOUR_DOMAIN/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET="whsec_..."

# Public URL of your site (used for Stripe redirects). On Vercel set to your production URL.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Admin image uploads (Content + product photos). Pick ONE option — no Vercel Blob required.
#
# Option A — Cloudinary free tier (easiest on Vercel): https://cloudinary.com → create unsigned upload preset
# NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
# NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=recchi_unsigned
# (Browser uploads directly to Cloudinary; no extra server storage.)
#
# Option B — Google Cloud Storage (reuses GOOGLE_SERVICE_ACCOUNT_JSON from Sheets, if you use it)
# Create a bucket, grant the service account "Storage Object Admin", enable public read on uploads/ or set a CDN base URL.
# GCS_BUCKET=your-bucket-name
# GCS_PUBLIC_BASE_URL=https://storage.googleapis.com/your-bucket-name
#
# Option C — S3-compatible (Cloudflare R2, AWS S3, Backblaze B2)
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_PUBLIC_BASE_URL=https://pub-xxx.r2.dev
#
# Local dev with no vars above saves to public/uploads/ automatically.

# Contact form — optional email notifications (https://resend.com)
RESEND_API_KEY=""
CONTACT_TO_EMAIL=""
# Verified domain in Resend, e.g. "Recchi Studio <hello@yourdomain.com>"
RESEND_FROM_EMAIL=""

# Product import from CSV (optional)
# Use a published Google Sheet CSV URL or any URL that returns CSV with the expected columns.
PRODUCTS_CSV_URL=""
